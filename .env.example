# Copy to .env and fill in real values. Never commit .env.
# All values here are placeholders — replace every 'changeme' / 'your-*-here'
# before running in any non-local environment.

# PostgreSQL connection URL (used by the api service and Alembic migrations).
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://yonko:changeme@db:5432/yonko

# Set to true to persist /analyze results (bundle, documents, findings) to the DB.
PERSIST_RESULTS=false

# AES-256-GCM key for field-level encryption (TOTP secrets at rest).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SAMANVAY_SECRET_KEY=your-secret-key-here

# Path to the local SQLite file used by the reviewer dashboard's case store.
SAMANVAY_DB_PATH=./backend/data/samanvay.sqlite

# Comma-separated list of allowed CORS origins for the FastAPI server.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# HMAC secret for identity number hashing (cross-document deduplication).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ID_HMAC_SECRET=your-hmac-secret-here

# Set to true to persist uploaded files to MinIO with AES256 encryption.
PERSIST_UPLOADS=false

# Secret used to sign access and refresh JWTs (HS256).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-jwt-secret-here

# Access-token lifetime in minutes (short by design).
AUTH_ACCESS_TOKEN_TTL_MINUTES=15

# Refresh-token lifetime in days (rotated on every use).
AUTH_REFRESH_TOKEN_TTL_DAYS=7

# Account lockout after repeated failed logins.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# PostgreSQL roles for Row-Level Security (migration 0006).
# APP_DB_PASSWORD is the app_user login password — the API connects with
# least-privilege SELECT/INSERT/UPDATE only (no DELETE, no DDL, audit-log
# INSERT-only). MIGRATION_USER_PASSWORD is migration_user's password —
# used only by alembic, never by the running API.
APP_DB_PASSWORD=changeme-app-user
MIGRATION_USER_PASSWORD=changeme-migration-user

# Optional: separate connection URL for alembic. When unset, alembic falls
# back to DATABASE_URL. Set this in production so migrations run as
# migration_user while the API connects as app_user.
# MIGRATION_DATABASE_URL=postgresql+psycopg2://migration_user:changeme-migration-user@db:5432/yonko

# MinIO (S3-compatible) object storage settings — used only when PERSIST_UPLOADS=true.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=yonko-uploads

# AES-256-GCM data keys for field-level encryption at rest (findings_pg.reason,
# review_decisions.reviewer_email, users_pg.totp_secret). Keys are NEVER stored
# in the database — only in the environment / secret manager.
# Generate a key: python -c "from app.security.crypto import generate_data_key; print(generate_data_key())"
# (64 hex chars = 32 bytes)
DATA_KEY_V1=your-data-key-v1-here
# Which key id encrypts NEW values (default: highest-numbered DATA_KEY_*).
# To rotate: add DATA_KEY_V2, set DATA_KEY_ACTIVE=v2, run
#   python backend/scripts/rotate_data_keys.py
# then remove DATA_KEY_V1 after verifying.
# DATA_KEY_ACTIVE=v1

# Optional dedicated key for searchable HMACs (equality lookups on encrypted
# columns). Derived from the active data key when unset.
# HMAC_INDEX_KEY=
