# Frontend (Vite) — baked in at build time
VITE_API_BASE_URL=http://localhost:8000

# Backend (FastAPI)
# Sessions are HMAC-keyed with this secret; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
YONKO_SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated browser origins allowed to call the API (your Vercel URL
# in production, local dev servers otherwise).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Hours before an idle session expires
SESSION_TTL_HOURS=24
# Set to 1 when running behind a reverse proxy (Render) so rate limiting
# sees real client IPs from X-Forwarded-For
TRUST_PROXY=0
# Optional PostgreSQL connection string (Render provides this automatically).
# Leave unset to use the local SQLite database.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Rate limits (defaults shown)
GLOBAL_RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=30
ANALYZE_RATE_LIMIT_PER_MINUTE=12
AUTH_MAX_FAILURES=5
AUTH_LOCKOUT_MINUTES=15