# Copy to .env and fill in real values. Never commit .env.
# All values here are placeholders — replace every 'changeme' / 'your-*-here'
# before running in any non-local environment.

# PostgreSQL connection URL (used by the api service and Alembic migrations).
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://yonko:changeme@db:5432/yonko

# Set to true to persist /analyze results (bundle, documents, findings) to the DB.
PERSIST_RESULTS=false

# AES-256-GCM key for field-level encryption (TOTP secrets at rest).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SAMANVAY_SECRET_KEY=your-secret-key-here

# Path to the local SQLite file used by the reviewer dashboard's case store.
SAMANVAY_DB_PATH=./backend/data/samanvay.sqlite

# Comma-separated list of allowed CORS origins for the FastAPI server.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# HMAC secret for identity number hashing (cross-document deduplication).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ID_HMAC_SECRET=your-hmac-secret-here

# Set to true to persist uploaded files to MinIO with AES256 encryption.
PERSIST_UPLOADS=false

# Secret used to sign access and refresh JWTs (HS256).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-jwt-secret-here

# Access-token lifetime in minutes (short by design).
AUTH_ACCESS_TOKEN_TTL_MINUTES=15

# Refresh-token lifetime in days (rotated on every use).
AUTH_REFRESH_TOKEN_TTL_DAYS=7

# Account lockout after repeated failed logins.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# MinIO (S3-compatible) object storage settings — used only when PERSIST_UPLOADS=true.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=yonko-uploads
